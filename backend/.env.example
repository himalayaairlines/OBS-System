# Copy to backend/.env and start the API with:
#   uvicorn main:app --host 0.0.0.0 --port 8000 --env-file .env
# Never commit the real .env.

# Fernet key that encrypts the stored SMTP password. Generate once and keep it safe:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing it means re-entering the SMTP password; it does not affect other data.
OBS_SECRET_KEY=

# 1 (default) runs the alert/email worker inside the API process.
# Set 0 when you run `python worker.py` as its own service.
OBS_EMBEDDED_WORKER=1
# Seconds between worker cycles.
OBS_WORKER_INTERVAL=15

# Only for an internal SMTP relay that has no TLS at all. Leave unset otherwise.
# OBS_SMTP_ALLOW_PLAINTEXT=1
# Trust a private certificate authority for the SMTP server's TLS certificate.
# OBS_SMTP_CA_FILE=C:\certs\corp-root.pem

# Public address of the web app. Used in password-reset and invitation links and
# as {{inventory_link}} in alert emails. Can also be set in the app under
# SMTP Settings > Application address.
# OBS_APP_URL=https://obs.example.com

# Existing settings
# OBS_ALLOWED_ORIGINS=https://ops.example.com
# Administrator recovery page: off unless this is set (12+ characters).
# OBS_ADMIN_RECOVERY_CODE=
# OBS_DB_PATH=D:\data\obs.db
