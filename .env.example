# Copy to .env next to docker-compose.yml (start.bat / start.sh do this for you).

# Port for the web app:  http://<server>:WEB_PORT
WEB_PORT=8080

# Port for the API that the iPad / Android app calls: http://<server>:API_PORT
API_PORT=8005

# Encryption key for the stored SMTP password. Leave empty and one is generated
# on the data volume automatically.
OBS_SECRET_KEY=

# Optional
# Administrator recovery page: off unless set (12+ characters).
# OBS_ADMIN_RECOVERY_CODE=
# Web address used in password-reset and invitation e-mail links.
# OBS_APP_URL=http://obs.example.com:8080
# OBS_SMTP_ALLOW_PLAINTEXT=1
